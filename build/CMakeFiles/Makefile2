.PHONY : app_gui

# codegen rule for target.
src/gui/CMakeFiles/app_gui.dir/codegen:
	$(MAKE) $(MAKESILENT) -f src\gui\CMakeFiles\app_gui.dir\build.make src/gui/CMakeFiles/app_gui.dir/codegen
	@$(CMAKE_COMMAND) -E cmake_echo_color "--switch=$(COLOR)" --progress-dir="D:\Semester 03\Local Online Judge\build\CMakeFiles" --progress-num=19,20,21,22,23,24,25 "Finished codegen for target app_gui"
.PHONY : src/gui/CMakeFiles/app_gui.dir/codegen

# clean rule for target.
src/gui/CMakeFiles/app_gui.dir/clean:
	$(MAKE) $(MAKESILENT) -f src\gui\CMakeFiles\app_gui.dir\build.make src/gui/CMakeFiles/app_gui.dir/clean
.PHONY : src/gui/CMakeFiles/app_gui.dir/clean

#=============================================================================
# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	$(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles\Makefile.cmake 0
.PHONY : cmake_check_build_system

